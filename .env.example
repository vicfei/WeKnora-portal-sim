SIM_ADDR=:8082
WEKNORA_BASE_URL=http://localhost:8080
WEKNORA_FRONTEND_URL=http://localhost:5173
WEKNORA_PLATFORM_KEY=<platform key with system_identity_bridge>
PORTAL_DB_DSN=host=localhost port=5432 user=postgres password=*** dbname=portal_proxy sslmode=disable
WEKNORA_TENANT_HINT=10008
# 会话落盘文件（含 JWT，0600；勿入 git）。留空=纯内存（重启即失）
SIM_SESSION_FILE=/absolute/path/to/portal-sessions.json
